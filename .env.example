# ══════════════════════════════════════════════
#  MeTube — Environment Variables
#  انسخ هذا الملف وسمّه .env وأضف قيمك
# ══════════════════════════════════════════════

# Hugging Face — النسخ الصوتي والترجمة (مجاني)
# سجّل على huggingface.co ← Settings ← Access Tokens
VITE_HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic — الملخص بالذكاء الاصطناعي
# console.anthropic.com ← API Keys
VITE_ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase — المشاركة المباشرة (مجاني)
# supabase.com ← New Project ← Settings ← API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
